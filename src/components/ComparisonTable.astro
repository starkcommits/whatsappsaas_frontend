---
---

<div class="rounded-3xl border border-ink-100 bg-white p-6 sm:p-10 shadow-soft">
  <div class="max-w-2xl mx-auto text-center mb-10">
    <span class="inline-flex items-center text-xs font-mono uppercase tracking-wider font-semibold px-3 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-100 mb-2">
      Transparent Billing
    </span>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-ink-950 font-display tracking-tight">
      Who pays what: zero middleman markup
    </h2>
    <p class="text-ink-600 text-sm mt-2">
      Clear separation between software license and Meta message delivery fees.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    
    <!-- Left Column: What You Pay ONO -->
    <div class="rounded-2xl border-2 border-brand-500 bg-brand-50/30 p-6 sm:p-8 flex flex-col justify-between relative">
      <div class="absolute -top-3 left-6">
        <span class="bg-brand-600 text-white text-[11px] font-mono font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-xs">
          Pay Once
        </span>
      </div>

      <div>
        <div class="text-xs uppercase tracking-wider text-brand-700 font-bold font-mono">
          Platform Software License
        </div>
        <div class="text-3xl sm:text-4xl font-extrabold text-ink-950 font-display mt-2">
          $50 <span class="text-sm font-normal text-ink-600 font-sans">one-time (about ₹4,199)</span>
        </div>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Full lifetime license to run the ONO WhatsApp business software for your team.
        </p>

        <ul class="mt-6 space-y-2.5 text-xs text-ink-700">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Shared team inbox for 3 agents</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Template builder & campaign scheduler</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Contact consent ledger & STOP handling</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>REST API access & webhook events</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Zero recurring platform subscription fees</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 pt-4 border-t border-brand-200 text-[11px] text-brand-800 font-medium">
        Billed once by ONO • 7-day money-back guarantee
      </div>
    </div>

    <!-- Right Column: What You Pay Meta Directly -->
    <div class="rounded-2xl border border-ink-100 bg-ink-50/60 p-6 sm:p-8 flex flex-col justify-between relative">
      <div class="absolute -top-3 left-6">
        <span class="bg-ink-700 text-white text-[11px] font-mono font-bold uppercase tracking-wider px-3 py-0.5 rounded-full">
          Pay Directly to Meta
        </span>
      </div>

      <div>
        <div class="text-xs uppercase tracking-wider text-ink-600 font-bold font-mono">
          Meta WhatsApp Cloud API Usage
        </div>
        <div class="text-3xl sm:text-4xl font-extrabold text-ink-950 font-display mt-2">
          Direct <span class="text-sm font-normal text-ink-600 font-sans">per-conversation rates</span>
        </div>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Conversation fees are billed directly to your payment method inside Meta Business Manager.
        </p>

        <ul class="mt-6 space-y-2.5 text-xs text-ink-700">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-ink-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Billed per 24-hour conversation window</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-ink-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Zero ONO markup: you pay Meta's baseline rates</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-ink-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Rates vary by country and conversation category</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-ink-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Free tier service conversations provided by Meta</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-ink-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>You manage your own credit card in Meta Business Manager</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 pt-4 border-t border-ink-200">
        <a
          href="https://developers.facebook.com/docs/whatsapp/pricing"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-brand-700 hover:text-brand-800 font-semibold inline-flex items-center gap-1"
        >
          <span>View Meta conversation pricing schedule</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

  </div>
</div>
