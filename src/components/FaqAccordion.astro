---
import type { FAQItem } from '../data/faq';
import Icon from './Icon.astro';

interface Props {
  items: FAQItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`space-y-4 max-w-3xl mx-auto ${className}`}>
  {items.map((item) => (
    <details class="group bg-white rounded-2xl border border-surface-200/90 shadow-card p-5 sm:p-6 transition-all duration-200 open:border-brand-400 open:shadow-md">
      <summary class="flex justify-between items-center cursor-pointer list-none select-none text-left">
        <h3 class="text-base sm:text-lg font-bold text-surface-900 group-open:text-brand-700 transition-colors pr-4">
          {item.question}
        </h3>
        <span class="w-8 h-8 rounded-full bg-surface-100 group-open:bg-brand-50 text-surface-600 group-open:text-brand-700 flex items-center justify-center shrink-0 transition-transform duration-200 group-open:rotate-180">
          <Icon name="chevron-down" class="w-4 h-4" />
        </span>
      </summary>
      <div class="mt-4 pt-4 border-t border-surface-100 text-sm text-surface-600 leading-relaxed">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>
