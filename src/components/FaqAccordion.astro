---
import type { FAQItem } from '../data/faq';

interface Props {
  items: FAQItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`space-y-3.5 max-w-3xl mx-auto ${className}`}>
  {items.map((item) => (
    <details class="group bg-white rounded-2xl border border-ink-100 p-5 sm:p-6 shadow-soft transition-all duration-150 open:border-ink-300">
      <summary class="flex justify-between items-center cursor-pointer list-none select-none text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 rounded-lg">
        <h3 class="text-base sm:text-lg font-bold text-ink-950 font-display transition-colors pr-4 leading-snug">
          {item.question}
        </h3>
        <span class="w-8 h-8 rounded-full bg-ink-50 group-open:bg-brand-50 text-ink-500 group-open:text-brand-700 flex items-center justify-center shrink-0 transition-transform duration-200 group-open:rotate-180">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </span>
      </summary>
      <div class="mt-4 pt-4 border-t border-ink-100 text-sm text-ink-500 leading-relaxed">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>
