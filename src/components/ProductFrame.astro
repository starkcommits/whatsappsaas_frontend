---
import { siteConfig } from '../config/site';

interface Props {
  path?: string;
  imageSrc?: string;
  alt?: string;
  caption?: string;
  class?: string;
}

const {
  path = '/inbox',
  imageSrc,
  alt = 'Product dashboard screen',
  caption = 'Sample data',
  class: className = '',
} = Astro.props;

// Build dynamic URL showing only the host of PUBLIC_APP_URL
const browserUrl = `https://${siteConfig.appHost}${path}`;
---

<figure class={`relative w-full ${className}`}>
  <!-- Browser Frame Wrapper -->
  <div class="rounded-2xl border border-ink-100 bg-ink-50 shadow-soft-lg overflow-hidden transition-all duration-300">
    <!-- Window Controls & Address Bar -->
    <div class="px-3 sm:px-4 py-2 bg-white border-b border-ink-100 flex items-center justify-between gap-2 sm:gap-4 select-none">
      <!-- Window Dots -->
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-ink-300/80 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-ink-300/80 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-ink-300/80 inline-block"></span>
      </div>

      <!-- Address Pill -->
      <div class="flex-1 min-w-0 max-w-[280px] sm:max-w-sm mx-auto bg-ink-50 border border-ink-100 rounded-lg px-2.5 py-1 text-center flex items-center justify-center gap-1.5 overflow-hidden">
        <svg class="w-3.5 h-3.5 text-ink-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span class="text-xs font-mono text-ink-700 truncate">{browserUrl}</span>
      </div>

      <!-- Sample Data Pill in Titlebar -->
      <div class="shrink-0 flex items-center justify-end">
        <span class="text-[10px] font-mono uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-ink-100 text-ink-700 border border-ink-300/50">
          Sample data
        </span>
      </div>
    </div>

    <!-- Frame Body: Image or Slot Mockup -->
    <div class="bg-white p-2 sm:p-4">
      {imageSrc ? (
        <img
          src={imageSrc}
          alt={alt}
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded-xl border border-ink-100 object-cover"
        />
      ) : (
        <slot />
      )}
    </div>
  </div>

  {caption && (
    <figcaption class="text-center text-xs text-ink-500 mt-2 font-mono">
      {caption}
    </figcaption>
  )}
</figure>
