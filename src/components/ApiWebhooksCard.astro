---
import { siteConfig } from '../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class={`py-16 sm:py-20 border-y border-ink-100 bg-ink-50/50 ${className}`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white border border-ink-100 rounded-3xl p-6 sm:p-10 shadow-soft overflow-hidden">
      
      <!-- Left Copy Column -->
      <div class="lg:col-span-6 space-y-4 min-w-0">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-100 text-xs font-semibold text-brand-700 font-mono">
          <span>CONNECTIVITY</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-extrabold text-ink-950 tracking-tight font-display">
          Connect your custom stack with API keys and webhooks
        </h3>

        <p class="text-ink-500 text-sm sm:text-base leading-relaxed">
          Manage messages, contacts, and template broadcasts programmatically. Generate scoped API keys in your dashboard and subscribe to live delivery, message, and consent change events.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
          <div class="flex items-start gap-2.5 p-3 rounded-xl bg-ink-50 border border-ink-100">
            <svg class="w-4 h-4 text-brand-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            <div>
              <span class="font-bold text-ink-900 block">Scoped API keys</span>
              <span class="text-ink-500">SHA-256 hashed storage with per-key role permissions.</span>
            </div>
          </div>

          <div class="flex items-start gap-2.5 p-3 rounded-xl bg-ink-50 border border-ink-100">
            <svg class="w-4 h-4 text-brand-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <div>
              <span class="font-bold text-ink-900 block">Event webhooks</span>
              <span class="text-ink-500">Real-time callbacks for delivered, read, and inbound replies.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Code Visual Column -->
      <div class="lg:col-span-6 min-w-0 w-full overflow-hidden">
        <div class="rounded-2xl border border-ink-700 bg-ink-950 p-4 sm:p-5 shadow-soft-lg text-ink-100 font-mono text-xs overflow-hidden" style="background-color: #07111F;">
          <div class="flex items-center justify-between pb-3 border-b border-ink-800 text-[11px] text-ink-500">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-ink-700 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-ink-700 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-ink-700 inline-block"></span>
            </div>
            <span class="text-ink-400">cURL • Sample API Call</span>
          </div>

          <pre class="pt-3 leading-relaxed text-ink-300 overflow-x-auto text-[11px] sm:text-xs"><code><span class="text-ink-500"># Send message via ONO REST API</span>
<span class="text-brand-400">curl</span> -X POST "https://{siteConfig.appHost}/whatsapp/api/send-message/" \
  -H "<span class="text-brand-400">Authorization:</span> Bearer ono_live_sample_key" \
  -H "<span class="text-brand-400">Content-Type:</span> application/json" \
  -d '&#123;
    <span class="text-signal">"to"</span>: "+919876543210",
    <span class="text-signal">"message"</span>: "Your booking is confirmed for tomorrow at 3 PM."
  &#125;'</code></pre>

          <div class="mt-3 pt-3 border-t border-ink-800 flex items-center justify-between text-[10px] text-ink-500">
            <span>Status: 200 OK • JSON</span>
            <span class="text-brand-400">Payload verified</span>
          </div>
        </div>
        <p class="text-[11px] text-center text-ink-500 mt-2 font-mono">
          Sample data • Live API endpoints documented in workspace settings
        </p>
      </div>

    </div>
  </div>
</section>
