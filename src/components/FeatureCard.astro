---
import Icon from './Icon.astro';

interface Props {
  id?: string;
  number?: number;
  title: string;
  description: string;
  badge?: string;
  icon?: string;
  keyPoints?: string[];
  class?: string;
}

const {
  id,
  number,
  title,
  description,
  badge,
  icon = 'chat-bubble',
  keyPoints = [],
  class: className = '',
} = Astro.props;
---

<article id={id} class={`bg-white rounded-2xl border border-ink-100 p-6 sm:p-7 shadow-soft hover:shadow-soft-lg hover:border-ink-200 transition-all duration-200 flex flex-col justify-between group ${className}`}>
  <div>
    <!-- Card Header / Icon -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="w-11 h-11 rounded-xl bg-brand-50 border border-brand-100 text-brand-700 flex items-center justify-center group-hover:bg-brand-600 group-hover:text-white transition-colors duration-200">
        <Icon name={icon} class="w-5 h-5" />
      </div>
      <div class="flex items-center gap-2">
        {badge && (
          <span class="text-[10px] font-mono font-semibold tracking-wider uppercase px-2.5 py-0.5 rounded-full bg-ink-50 text-ink-700 border border-ink-100">
            {badge}
          </span>
        )}
        {number && (
          <span class="text-xs font-mono font-medium text-ink-400">
            #{number < 10 ? `0${number}` : number}
          </span>
        )}
      </div>
    </div>

    <!-- Title & Desc -->
    <h3 class="text-lg font-bold text-ink-950 font-display mb-2 group-hover:text-brand-800 transition-colors leading-snug">
      {title}
    </h3>
    <p class="text-sm text-ink-500 leading-relaxed">
      {description}
    </p>

    <!-- Key Points list if provided -->
    {keyPoints.length > 0 && (
      <ul class="mt-4 pt-4 border-t border-ink-100 space-y-2 text-xs text-ink-700">
        {keyPoints.map((point) => (
          <li class="flex items-start gap-2">
            <svg class="w-3.5 h-3.5 text-brand-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
