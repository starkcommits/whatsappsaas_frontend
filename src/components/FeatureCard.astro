---
import Icon from './Icon.astro';

interface Props {
  id?: string;
  number?: number;
  title: string;
  description: string;
  badge?: string;
  icon?: string;
  keyPoints?: string[];
  class?: string;
}

const {
  id,
  number,
  title,
  description,
  badge,
  icon = 'chat-bubble',
  keyPoints = [],
  class: className = '',
} = Astro.props;
---

<article id={id} class={`bg-white rounded-2xl border border-surface-200/90 p-6 sm:p-7 shadow-card hover:shadow-card-hover transition-all duration-200 flex flex-col justify-between group ${className}`}>
  <div>
    <!-- Card Header / Icon -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="w-11 h-11 rounded-xl bg-brand-50 border border-brand-200 text-brand-700 flex items-center justify-center group-hover:bg-brand-600 group-hover:text-white transition-colors duration-200">
        <Icon name={icon} class="w-5 h-5" />
      </div>
      <div class="flex items-center gap-2">
        {badge && (
          <span class="text-[11px] font-semibold tracking-wide uppercase px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-800 border border-brand-200/80">
            {badge}
          </span>
        )}
        {number && (
          <span class="text-xs font-mono font-medium text-surface-400">
            #{number < 10 ? `0${number}` : number}
          </span>
        )}
      </div>
    </div>

    <!-- Title & Desc -->
    <h3 class="text-lg font-bold text-surface-900 mb-2 group-hover:text-brand-800 transition-colors">
      {title}
    </h3>
    <p class="text-sm text-surface-600 leading-relaxed">
      {description}
    </p>

    <!-- Key Points list if provided -->
    {keyPoints.length > 0 && (
      <ul class="mt-4 pt-4 border-t border-surface-100 space-y-2 text-xs text-surface-600">
        {keyPoints.map((point) => (
          <li class="flex items-start gap-2">
            <span class="text-brand-600 mt-0.5">
              <Icon name="check" class="w-3.5 h-3.5" />
            </span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
