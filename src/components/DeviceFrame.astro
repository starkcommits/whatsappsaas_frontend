---
import ProductFrame from './ProductFrame.astro';

interface Props {
  imageSrc?: string;
  alt?: string;
  caption?: string;
  browserUrl?: string;
  class?: string;
}

const {
  imageSrc,
  alt = 'Product dashboard screen',
  caption = 'Sample data',
  browserUrl,
  class: className = '',
} = Astro.props;

// Extract path if a full browserUrl was passed
let path = '/inbox';
if (browserUrl) {
  try {
    const parsed = new URL(browserUrl);
    path = parsed.pathname;
  } catch {
    path = browserUrl.startsWith('/') ? browserUrl : '/inbox';
  }
}
---

<ProductFrame
  path={path}
  imageSrc={imageSrc}
  alt={alt}
  caption={caption}
  class={className}
>
  <slot />
</ProductFrame>
