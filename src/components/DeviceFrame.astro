---
interface Props {
  imageSrc?: string;
  alt?: string;
  caption?: string;
  browserUrl?: string;
  class?: string;
}

const {
  imageSrc,
  alt = 'Product dashboard screen',
  caption,
  browserUrl = 'https://app.flexing.in',
  class: className = '',
} = Astro.props;
---

<figure class={`relative w-full ${className}`}>
  <!-- Browser Frame Wrapper -->
  <div class="rounded-2xl border border-surface-200 bg-surface-100 shadow-xl overflow-hidden transition-all duration-300">
    <!-- Window Controls & Address Bar -->
    <div class="px-4 py-2.5 bg-surface-200/60 border-b border-surface-300/50 flex items-center justify-between gap-4 select-none">
      <!-- Dots -->
      <div class="flex items-center gap-1.5 w-14">
        <span class="w-3 h-3 rounded-full bg-red-400/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-400/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-400/80 inline-block"></span>
      </div>

      <!-- Address pill -->
      <div class="flex-1 max-w-sm mx-auto bg-white/90 border border-surface-300/60 rounded-md px-3 py-1 text-center flex items-center justify-center gap-1.5 shadow-2xs">
        <svg class="w-3.5 h-3.5 text-surface-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span class="text-xs font-mono text-surface-600 truncate">{browserUrl}</span>
      </div>

      <!-- Dummy Right Controls for Balance -->
      <div class="w-14 flex justify-end gap-1 text-surface-400">
        <span class="w-4 h-4 rounded hover:bg-surface-300/50 flex items-center justify-center text-xs">⟳</span>
      </div>
    </div>

    <!-- Frame Body: Image or Slot (Mockup) -->
    <div class="bg-surface-50 p-2 sm:p-4">
      {imageSrc ? (
        <img
          src={imageSrc}
          alt={alt}
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded-xl shadow-xs border border-surface-200 object-cover"
        />
      ) : (
        <slot />
      )}
    </div>
  </div>

  {caption && (
    <figcaption class="text-center text-xs text-surface-500 mt-2.5 font-medium">
      {caption}
    </figcaption>
  )}
</figure>
