---
import { siteConfig } from '../config/site';
import HalftoneWordmarkFooter from '../islands/HalftoneWordmarkFooter';

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/features' },
      { label: 'How It Works', href: '/how-it-works' },
      { label: 'Security & Tenancy', href: '/security' },
      { label: 'Use Cases', href: '/use-cases' },
      { label: 'App Login', href: siteConfig.links.login },
    ],
  },
  {
    title: 'Pricing & License',
    links: [
      { label: 'Pricing Overview', href: '/pricing' },
      { label: 'Fair-Use Limits', href: '/pricing#limits' },
      { label: 'Meta Direct Rates', href: '/pricing#meta-rates' },
      { label: 'Refund Guarantee', href: '/refund' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About ONO', href: '/about' },
      { label: 'Contact Support', href: '/contact' },
      { label: 'Frequently Asked Questions', href: '/pricing#faq' },
    ],
  },
  {
    title: 'Legal & Compliance',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
      { label: 'Refund & Cancellation', href: '/refund' },
      { label: 'Acceptable Use Policy', href: '/acceptable-use' },
      { label: 'Shipping & Delivery', href: '/shipping-and-delivery' },
    ],
  },
];
---

<HalftoneWordmarkFooter
  client:visible
  wordmark="ono"
  label={siteConfig.legalName}
  meta={`${siteConfig.address} • Support: ${siteConfig.supportEmail}`}
  disclaimer={`${siteConfig.name} is not affiliated with, endorsed by or sponsored by WhatsApp or Meta. WhatsApp is a trademark of Meta Platforms, Inc.`}
  columns={columns}
  palette={{
    background: '#07111F',
    ink: '#E8ECF0',
    warm: '#12A57D',
  }}
  height="720px"
  dotGap={6}
  radius={85}
  crop={0.28}
  grain={0.4}
/>

