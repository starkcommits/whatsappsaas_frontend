---
import { siteConfig } from '../config/site';
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const productLinks = [
  { label: 'Features', href: '/features' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Security & Tenancy', href: '/security' },
  { label: 'Use Cases', href: '/use-cases' },
  { label: 'App Login', href: siteConfig.links.login },
];

const pricingLinks = [
  { label: 'Pricing Overview', href: '/pricing' },
  { label: 'Fair-Use Limits', href: '/pricing#limits' },
  { label: 'Meta Direct Rates', href: '/pricing#meta-rates' },
  { label: 'Refund Guarantee', href: '/refund' },
];

const companyLinks = [
  { label: 'About ONO', href: '/about' },
  { label: 'Contact Support', href: '/contact' },
  { label: 'Frequently Asked Questions', href: '/pricing#faq' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Refund & Cancellation', href: '/refund' },
  { label: 'Acceptable Use Policy', href: '/acceptable-use' },
  { label: 'Shipping & Delivery', href: '/shipping-and-delivery' },
];
---

<footer class="bg-ink-950 text-ink-300 border-t border-ink-900 pt-16 pb-12 text-sm" style="background-color: #07111F;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-ink-900">
      
      <!-- Col 1: Brand & Entity -->
      <div class="space-y-4">
        <a href="/" class="group inline-flex items-center" aria-label="ONO Home">
          <Logo variant="reversed" size="md" />
        </a>
        <p class="text-ink-400 text-xs sm:text-sm leading-relaxed">
          Calm, reliable WhatsApp operations for growing teams. Connect your number, collaborate in a shared inbox, and pay zero markup.
        </p>

        <div class="text-xs text-ink-400 space-y-1.5 pt-1">
          <p class="text-ink-300 font-semibold">{siteConfig.legalName}</p>
          <p class="text-ink-500 leading-relaxed">{siteConfig.address}</p>
          <p class="pt-1">
            <span class="text-ink-500">Support:</span>{' '}
            <a href={`mailto:${siteConfig.supportEmail}`} class="text-brand-400 hover:text-brand-300 underline underline-offset-2">
              {siteConfig.supportEmail}
            </a>
          </p>
        </div>
      </div>

      <!-- Col 2: Product -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3 font-display">Product</h3>
        <ul class="space-y-2 text-xs">
          {productLinks.map((item) => (
            <li>
              <a href={item.href} class="text-ink-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Pricing & Billing -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3 font-display">Pricing & License</h3>
        <ul class="space-y-2 text-xs">
          {pricingLinks.map((item) => (
            <li>
              <a href={item.href} class="text-ink-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Company & Trust -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3 font-display">Company</h3>
        <ul class="space-y-2 text-xs">
          {companyLinks.map((item) => (
            <li>
              <a href={item.href} class="text-ink-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Legal & Policies -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3 font-display">Legal & Compliance</h3>
        <ul class="space-y-2 text-xs">
          {legalLinks.map((item) => (
            <li>
              <a href={item.href} class="text-ink-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Mandatory Meta Non-Affiliation Disclaimer & Copyright -->
    <div class="pt-8 space-y-4 text-xs text-ink-500">
      <div class="p-4 rounded-xl bg-ink-900/60 border border-ink-800 leading-relaxed text-ink-400">
        <p>
          <strong class="text-ink-300">Notice:</strong> {siteConfig.metaDisclaimer}
        </p>
      </div>

      <div class="pt-2 text-[11px] text-center text-ink-500">
        <p>© {currentYear} {siteConfig.legalName}. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
