---
// Dedicated Hero Mockup matching the exact design spec
import { siteConfig } from '../../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const browserUrl = `https://${siteConfig.appHost}/inbox`;
---

<div class={`relative w-full max-w-[620px] mx-auto lg:max-w-none ${className}`}>
  <!-- Floating Top-Right Badge: "Template approved · Sample data" -->
  <div class="absolute -top-3.5 right-4 sm:right-6 z-30 bg-white border border-slate-200/90 shadow-md px-3.5 py-1.5 rounded-full flex items-center gap-2 text-xs font-medium text-slate-800">
    <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
    <span class="text-slate-900 font-semibold">Template approved</span>
    <span class="text-slate-400 text-[11px]">·</span>
    <span class="text-slate-500 font-normal">Sample data</span>
  </div>

  <!-- Browser Container Window -->
  <div class="rounded-2xl border border-slate-200 bg-white shadow-[0_20px_50px_rgba(7,17,31,0.1)] overflow-hidden transition-all duration-300">
    
    <!-- Window Bar with Traffic Lights & URL Pill -->
    <div class="px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 flex items-center justify-between gap-3 select-none">
      <!-- 3 Grey Dots -->
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-slate-300 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-slate-300 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-slate-300 inline-block"></span>
      </div>

      <!-- Centered URL Pill -->
      <div class="flex-1 max-w-[280px] sm:max-w-xs mx-auto bg-white border border-slate-200 rounded-lg px-3 py-1 flex items-center justify-center gap-2 text-xs font-mono text-slate-600 shadow-2xs">
        <svg class="w-3 h-3 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span class="truncate">{browserUrl}</span>
      </div>

      <!-- Right spacer to balance dots -->
      <div class="w-10 shrink-0"></div>
    </div>

    <!-- App Body: Left Dark Sidebar + Main Chat Panel -->
    <div class="flex min-h-[440px] sm:min-h-[480px] bg-slate-100/70">
      
      <!-- Left Dark Sidebar (#0B1320) -->
      <aside class="hidden sm:flex flex-col w-36 sm:w-40 lg:w-44 shrink-0 bg-[#0B1320] text-slate-300 p-3 select-none justify-between border-r border-slate-800/80">
        <div class="space-y-4">
          
          <!-- ONO Brand Logo: Two rings connected by a bridge -->
          <div class="flex items-center gap-2.5 px-2 py-1">
            <svg class="w-7 h-5 text-emerald-400 shrink-0" viewBox="0 0 36 20" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="9" cy="10" r="6" />
              <circle cx="27" cy="10" r="6" />
              <line x1="15" y1="10" x2="21" y2="10" />
            </svg>
            <span class="font-extrabold text-white text-base tracking-wider font-display">ONO</span>
          </div>

          <!-- Nav Items -->
          <nav class="space-y-1 text-xs" aria-label="Inbox Navigation">
            
            <!-- Dashboard -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-default">
              <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span class="truncate">Dashboard</span>
            </div>

            <!-- Inbox (Active) -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg bg-[#0E8A68] text-white font-medium shadow-xs cursor-default">
              <svg class="w-4 h-4 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
              <span class="truncate">Inbox</span>
            </div>

            <!-- Contacts -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-default">
              <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              <span class="truncate">Contacts</span>
            </div>

            <!-- Labels -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-default">
              <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              <span class="truncate">Labels</span>
            </div>

            <!-- Opt-in Links -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-default">
              <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <span class="truncate">Opt-in Links</span>
            </div>

            <!-- Templates -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-default">
              <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
              <span class="truncate">Templates</span>
            </div>

            <!-- Flows -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-default">
              <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="6" height="6" rx="1"></rect>
                <rect x="16" y="3" width="6" height="6" rx="1"></rect>
                <rect x="9" y="15" width="6" height="6" rx="1"></rect>
                <path d="M5 9v3a2 2 0 0 0 2 2h2"></path>
                <path d="M19 9v3a2 2 0 0 1-2 2h-2"></path>
              </svg>
              <span class="truncate">Flows</span>
            </div>

            <!-- Campaigns -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-default">
              <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <span class="truncate">Campaigns</span>
            </div>

            <!-- Analytics -->
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-colors cursor-default">
              <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
              <span class="truncate">Analytics</span>
            </div>

          </nav>
        </div>
      </aside>

      <!-- Main Chat Area -->
      <main class="flex-1 flex flex-col bg-white min-w-0">
        
        <!-- Chat Header -->
        <header class="bg-white border-b border-slate-200/80 px-3.5 sm:px-4 py-2.5 flex items-center justify-between gap-2 shrink-0 select-none">
          <!-- Customer Identity -->
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-bold text-slate-900 text-sm tracking-tight truncate">Aarav Sharma</span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                VIP Lead
              </span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-50/60 text-emerald-700 border border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                Website Form
              </span>
            </div>
            <div class="text-[11px] text-slate-500 font-mono mt-0.5">
              +91 98765 43210
            </div>
          </div>

          <!-- Header Action Buttons -->
          <div class="flex items-center gap-1.5 shrink-0">
            <button type="button" class="px-2.5 py-1 rounded-md text-xs font-medium border border-slate-200 text-slate-700 bg-white hover:bg-slate-50 shadow-2xs transition-colors">
              Transfer
            </button>
            <button type="button" class="px-2.5 py-1 rounded-md text-xs font-medium border border-slate-200 text-slate-700 bg-white hover:bg-slate-50 shadow-2xs transition-colors">
              Resolve
            </button>
            <button type="button" class="w-6 h-6 rounded-md border border-slate-200 text-slate-500 bg-white hover:bg-slate-50 flex items-center justify-center text-xs shadow-2xs">
              ?
            </button>
          </div>
        </header>

        <!-- Message Feed -->
        <div class="flex-1 p-3.5 sm:p-4 space-y-3 bg-[#F8FAFC] flex flex-col justify-start overflow-y-auto">
          
          <!-- Customer Inquiry Bubble -->
          <div class="flex justify-start">
            <div class="max-w-[90%] sm:max-w-[82%] bg-white border border-slate-200 rounded-2xl rounded-tl-sm p-3 sm:p-3.5 shadow-2xs">
              <p class="text-slate-800 text-xs sm:text-[13px] leading-relaxed">
                Hello! I saw your service broadcast. Can I book a consultation session for our team tomorrow?
              </p>
              <div class="text-[10px] text-slate-400 text-right mt-1.5">10:38 AM</div>
            </div>
          </div>

          <!-- Team Note (Internal Shared Note) -->
          <div class="bg-[#FEFCE8] border border-amber-200/90 rounded-xl p-2.5 sm:p-3 text-xs flex items-start gap-2 shadow-2xs">
            <div class="flex items-center gap-1 text-amber-800 font-bold shrink-0">
              <svg class="w-3.5 h-3.5 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              <span>Team Note:</span>
            </div>
            <div class="text-amber-900 leading-relaxed">
              High-priority client inquiry. Offered priority booking slot.
            </div>
          </div>

          <!-- Outbound Agent Reply Bubble with WhatsApp Flow Form Button -->
          <div class="flex justify-end">
            <div class="max-w-[92%] sm:max-w-[85%] bg-[#E7F6F1] border border-emerald-200 text-emerald-950 rounded-2xl rounded-tr-sm p-3 sm:p-3.5 shadow-2xs space-y-2.5">
              <p class="text-xs sm:text-[13px] leading-relaxed text-emerald-950">
                Hi Aarav! Absolutely. Please tap below to choose your preferred time slot directly in WhatsApp:
              </p>
              
              <!-- Flow Form Card inside bubble -->
              <div class="bg-white rounded-xl border border-emerald-300 p-2 sm:p-2.5 shadow-2xs flex items-center justify-center gap-2 cursor-pointer hover:bg-emerald-50/50 transition-colors">
                <!-- Generic chat bubble icon (per AGENTS.md rule: do not use WhatsApp official logo) -->
                <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span class="text-xs font-semibold text-emerald-900 flex items-center gap-1.5">
                  <span>📅</span> Open Booking Form (Flow)
                </span>
                <span class="text-emerald-600 font-bold text-xs ml-0.5">→</span>
              </div>

              <!-- Message metadata: timestamp + read double checkmarks -->
              <div class="text-[10px] text-emerald-800 text-right font-medium">
                10:40 AM · Read <span class="text-emerald-600 font-bold">✓✓</span>
              </div>
            </div>
          </div>

          <!-- Inbound Customer Confirmation -->
          <div class="flex justify-start">
            <div class="max-w-[90%] sm:max-w-[82%] bg-white border border-slate-200 rounded-2xl rounded-tl-sm p-3 sm:p-3.5 shadow-2xs">
              <p class="text-slate-800 text-xs sm:text-[13px] leading-relaxed">
                Form submitted! Selected tomorrow at 3:00 PM. Looking forward to it!
              </p>
              <div class="text-[10px] text-slate-400 text-right mt-1.5">10:42 AM</div>
            </div>
          </div>

          <!-- Customer Active Status Indicator -->
          <div class="flex items-center gap-1.5 pt-1 text-slate-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse [animation-delay:0.2s]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse [animation-delay:0.4s]"></span>
            <span class="text-[11px] text-slate-500 font-medium ml-1">Customer is active</span>
          </div>

        </div>

      </main>

    </div>

  </div>
</div>
