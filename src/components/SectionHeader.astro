---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  theme?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  title,
  intro,
  align = 'center',
  theme = 'light',
  class: className = '',
} = Astro.props;

const isDark = theme === 'dark';
---

<div class={`max-w-3xl ${align === 'center' ? 'mx-auto text-center' : 'text-left'} ${className}`}>
  {eyebrow && (
    <div class="mb-3">
      <span class={`inline-flex items-center text-xs font-mono uppercase tracking-wider font-semibold px-3 py-1 rounded-full ${
        isDark 
          ? 'bg-ink-800 text-brand-300 border border-ink-700' 
          : 'bg-brand-50 text-brand-700 border border-brand-100'
      }`}>
        {eyebrow}
      </span>
    </div>
  )}

  <h2 class={`text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight font-display ${
    isDark ? 'text-white' : 'text-ink-950'
  }`}>
    {title}
  </h2>

  {intro && (
    <p class={`mt-4 text-base sm:text-lg leading-relaxed ${
      isDark ? 'text-ink-300' : 'text-ink-500'
    }`}>
      {intro}
    </p>
  )}
</div>
