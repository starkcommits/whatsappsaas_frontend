---
interface Props {
  value: string;
  label: string;
  helper?: string;
  caption?: string;
  trend?: string;
  class?: string;
}

const {
  value,
  label,
  helper,
  caption = 'Sample data',
  trend,
  class: className = '',
} = Astro.props;
---

<div class={`p-5 rounded-2xl bg-white border border-ink-100 shadow-soft flex flex-col justify-between ${className}`}>
  <div>
    <div class="flex items-center justify-between gap-2 mb-1">
      <span class="text-xs font-semibold text-ink-500 uppercase tracking-wider">{label}</span>
      {trend && (
        <span class="text-[11px] font-mono font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">
          {trend}
        </span>
      )}
    </div>
    <div class="text-3xl font-extrabold text-ink-950 font-display tracking-tight">
      {value}
    </div>
    {helper && (
      <p class="text-xs text-ink-500 mt-1">{helper}</p>
    )}
  </div>

  <div class="mt-3 pt-2.5 border-t border-ink-100 flex items-center justify-between text-[10px] text-ink-400 font-mono">
    <span>Metric</span>
    <span>{caption}</span>
  </div>
</div>
