---
import { siteConfig } from '../config/site';
import { lifetimePlan } from '../data/plans';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  class?: string;
}

const {
  title = 'Ready to streamline your WhatsApp business conversations?',
  subtitle = `Get full lifetime access for just $${lifetimePlan.priceUSD}${lifetimePlan.priceINR ? ` (₹${lifetimePlan.priceINR.toLocaleString('en-IN')})` : ''} one-time. No monthly fees, no markup on WhatsApp messages.`,
  buttonText = 'Get lifetime access',
  class: className = '',
} = Astro.props;
---

<div class={`relative bg-gradient-to-br from-brand-900 via-brand-800 to-surface-900 text-white rounded-3xl p-8 sm:p-12 md:p-16 shadow-2xl overflow-hidden ${className}`}>
  <!-- Decorative background subtle glow rings -->
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-brand-500/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-emerald-400/10 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
    <div class="inline-flex items-center gap-2 bg-brand-500/20 border border-brand-400/30 text-brand-200 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider">
      <span>⚡ One-Time License</span>
      <span>•</span>
      <span>7-Day Refund Guarantee</span>
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white leading-tight">
      {title}
    </h2>

    <p class="text-base sm:text-lg text-brand-100/90 leading-relaxed max-w-2xl mx-auto">
      {subtitle}
    </p>

    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button
        href={siteConfig.links.signup}
        size="lg"
        class="w-full sm:w-auto bg-white text-brand-950 hover:bg-brand-50 shadow-lg font-bold"
        isAppCta={true}
      >
        {buttonText}
        <Icon name="arrow-right" class="w-4 h-4 ml-1" />
      </Button>

      <Button
        href="/how-it-works"
        variant="ghost"
        size="lg"
        class="w-full sm:w-auto text-white hover:bg-white/10 hover:text-white border border-white/20"
      >
        See how it works
      </Button>
    </div>

    <p class="text-xs text-brand-200/80 pt-2">
      Connect your WhatsApp number in minutes via official Meta Embedded Signup.
    </p>
  </div>
</div>
