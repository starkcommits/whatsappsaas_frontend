---
import { siteConfig } from '../config/site';
import { lifetimePlan } from '../data/plans';
import { AnimatedCta } from './ui/animated-hero';

interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  class?: string;
}

const {
  title = 'Every customer conversation on WhatsApp,',
  subtitle = `Get lifetime access for $${lifetimePlan.priceUSD} (${lifetimePlan.priceINRFormatted}) one-time. No monthly fees, no markup on WhatsApp messages.`,
  buttonText = 'Get lifetime access',
  class: className = '',
} = Astro.props;

const staticTitle = title.includes('in one shared inbox')
  ? 'Every customer conversation on WhatsApp,'
  : title;
---

<AnimatedCta
  client:visible
  staticTitle={staticTitle}
  subtitle={subtitle}
  primaryButtonText={buttonText}
  primaryButtonUrl={siteConfig.links.signup}
  secondaryButtonText="See how it works"
  secondaryButtonUrl="/how-it-works"
  className={className}
/>
