---
import { siteConfig } from '../config/site';
import NavbarSection2 from '../islands/NavbarSection2';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<NavbarSection2
  client:load
  currentPath={currentPath}
  loginUrl={siteConfig.links.login}
  signupUrl={siteConfig.links.signup}
/>

