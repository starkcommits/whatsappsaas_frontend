---
import { siteConfig } from '../config/site';
import Logo from './Logo.astro';
import MobileNavDrawer from '../islands/MobileNavDrawer';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const productLinks = [
  { label: 'Features', href: '/features', desc: '10 built-in WhatsApp business capabilities' },
  { label: 'How It Works', href: '/how-it-works', desc: '4-step onboarding from number to campaigns' },
  { label: 'Security & Tenancy', href: '/security', desc: '2FA, audit logs, hashed keys, data isolation' },
  { label: 'Use Cases', href: '/use-cases', desc: 'Workflows for retail, clinics, real estate, services' },
];

const mainLinks = [
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-ink-100 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="group flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 rounded-lg p-1" aria-label="ONO Home">
        <Logo size="md" />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main Navigation">
        <!-- Product Dropdown Menu -->
        <div class="relative group" id="product-menu">
          <button
            type="button"
            class="px-3.5 py-2 text-sm font-medium text-ink-700 hover:text-ink-950 rounded-lg transition-colors flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-brand-600"
            aria-expanded="false"
            aria-haspopup="true"
            id="product-menu-button"
          >
            <span>Product</span>
            <svg class="w-4 h-4 text-ink-500 group-hover:text-ink-700 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- Dropdown Card -->
          <div
            class="absolute top-full left-0 w-72 pt-2 opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:visible transition-all duration-150 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto"
            role="menu"
            aria-labelledby="product-menu-button"
          >
            <div class="bg-white border border-ink-100 rounded-2xl p-2 shadow-soft-lg">
              {productLinks.map((item) => (
                <a
                  href={item.href}
                  class="block p-2.5 rounded-xl hover:bg-ink-50 transition-colors group/item focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
                  role="menuitem"
                >
                  <div class="text-sm font-semibold text-ink-900 group-hover/item:text-brand-700 transition-colors">
                    {item.label}
                  </div>
                  <div class="text-xs text-ink-500 mt-0.5 leading-snug">
                    {item.desc}
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        {mainLinks.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 text-sm font-medium rounded-lg transition-colors ${
                isActive
                  ? 'text-brand-700 bg-brand-50 font-semibold'
                  : 'text-ink-700 hover:text-ink-950 hover:bg-ink-50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Auth & Single Filled CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={siteConfig.links.login}
          class="px-4 py-2.5 text-sm font-semibold text-ink-700 hover:text-ink-950 hover:bg-ink-50 rounded-xl transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 select-none"
          data-app-cta="true"
        >
          Login
        </a>

        <a
          href={siteConfig.links.signup}
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl shadow-soft transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 active:scale-[0.98] whitespace-nowrap select-none"
          data-app-cta="true"
        >
          Get lifetime access
        </a>
      </div>

      <!-- Mobile Navigation Drawer (React Island via Radix Dialog with Focus Trap) -->
      <div class="flex items-center gap-2 sm:hidden">
        <a
          href={siteConfig.links.signup}
          class="px-3.5 py-2 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-lg shadow-soft transition-colors whitespace-nowrap"
          data-app-cta="true"
        >
          Get access
        </a>
        <MobileNavDrawer
          client:idle
          productLinks={productLinks}
          mainLinks={mainLinks}
          loginUrl={siteConfig.links.login}
          signupUrl={siteConfig.links.signup}
        />
      </div>

    </div>
  </div>
</header>
