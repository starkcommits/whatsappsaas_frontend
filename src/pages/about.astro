---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PrinciplesGrid from '../islands/PrinciplesGrid';
import { siteConfig } from '../config/site';
---

<Layout
  title={`About Us — ${siteConfig.name} by ${siteConfig.legalName}`}
  description={`Learn about ${siteConfig.legalName} and our mission to provide transparent, one-time licensed WhatsApp software for growing businesses.`}
>
  <!-- Header -->
  <section class="py-16 md:py-24 bg-ink-50/60 border-b border-ink-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 bg-brand-50 border border-brand-100 px-3.5 py-1 rounded-full mb-4">
        <span>About Our Platform</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-950 tracking-tight font-display leading-tight">
        Transparent WhatsApp tools for growing businesses
      </h1>
      <p class="text-base sm:text-lg text-ink-500 mt-4 leading-relaxed">
        {siteConfig.name} is developed and maintained by {siteConfig.legalName}. We believe business software should be clear, reliable, and honest.
      </p>
    </div>
  </section>

  <!-- Narrative Section -->
  <Section background="white">
    <div class="max-w-3xl mx-auto space-y-6 text-base text-ink-700 leading-relaxed">
      <h2 class="text-2xl font-bold text-ink-950 font-display tracking-tight">
        Why we built {siteConfig.name}
      </h2>
      <p>
        WhatsApp is the primary channel for businesses to connect with customers across India and globally. However, most existing platforms lock businesses into recurring monthly subscriptions and add markups on top of Meta's messaging rates.
      </p>
      <p>
        We built <strong>{siteConfig.name}</strong> to offer a straightforward alternative: pay a single one-time license fee to own the platform, and connect directly to Meta's WhatsApp Business Platform (Cloud API) so you pay Meta at their exact rates.
      </p>
      <p>
        There are no per-message software markups, no recurring monthly fees, and no unneeded complexity. Just a shared team inbox, verified consent tracking, approved template broadcasts, and in-chat WhatsApp Flows.
      </p>

      <div class="p-6 rounded-2xl bg-ink-50 border border-ink-100 mt-8 space-y-2 text-sm">
        <h3 class="font-bold text-ink-950 font-display">Company Information</h3>
        <p><span class="text-ink-500">Legal Entity:</span> <strong>{siteConfig.legalName}</strong></p>
        <p><span class="text-ink-500">Registered Office:</span> {siteConfig.address}</p>
        <p><span class="text-ink-500">Inquiries:</span> <a href={`mailto:${siteConfig.supportEmail}`} class="text-brand-700 hover:underline">{siteConfig.supportEmail}</a></p>
      </div>
    </div>
  </Section>

  <!-- Core Principles Grid -->
  <Section background="default" class="border-t border-ink-100">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 mb-2">
          Core Operating Principles
        </h2>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-ink-950 font-display tracking-tight">
          How we design and operate {siteConfig.name}
        </h3>
      </div>

      <PrinciplesGrid client:visible />
    </div>
  </Section>
</Layout>
