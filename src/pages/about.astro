---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { siteConfig } from '../config/site';

const values = [
  {
    title: 'Zero Message Markup',
    desc: 'You should pay Meta directly for what Meta charges. We never insert ourselves as a billing toll booth on your customer conversations.',
    icon: 'tag',
  },
  {
    title: 'One-Time Licensing',
    desc: 'Small businesses do not need another $100/month recurring software bill for basic customer inbox and broadcast tools.',
    icon: 'check',
  },
  {
    title: 'Direct Meta Connectivity',
    desc: 'All messaging runs on the official Meta WhatsApp Cloud API via your own Business Manager. No third-party scrapers or unstable workarounds.',
    icon: 'connect',
  },
  {
    title: 'Customer Data Ownership',
    desc: 'Your contacts and conversation records belong to you. We provide export and deletion tools so you maintain complete control.',
    icon: 'lock',
  },
];
---

<Layout
  title={`About Us — ${siteConfig.name} by ${siteConfig.legalName}`}
  description={`Learn about ${siteConfig.legalName} and our mission to provide transparent, one-time licensed WhatsApp software for growing businesses.`}
>
  <!-- Header -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-brand-50/50 via-surface-50 to-surface-50 border-b border-surface-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-700 bg-brand-100/70 border border-brand-200 px-3.5 py-1 rounded-full mb-4">
        <span>About Our Platform</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-surface-900 tracking-tight leading-tight">
        Transparent WhatsApp tools for growing businesses
      </h1>
      <p class="text-base sm:text-lg text-surface-600 mt-4 leading-relaxed">
        {siteConfig.name} is developed and maintained by {siteConfig.legalName}. We believe business software should be simple, affordable, and honest.
      </p>
    </div>
  </section>

  <!-- Narrative Section -->
  <Section background="white">
    <div class="max-w-3xl mx-auto space-y-6 text-base text-surface-700 leading-relaxed">
      <h2 class="text-2xl font-bold text-surface-900 tracking-tight">
        Why we built {siteConfig.name}
      </h2>
      <p>
        WhatsApp has become the primary channel for businesses to connect with customers across India and globally. However, most existing software platforms lock businesses into expensive recurring subscriptions—and worse, tack on hidden 30% to 100% markups on top of Meta's actual messaging rates.
      </p>
      <p>
        We built <strong>{siteConfig.name}</strong> to offer a straightforward alternative: pay a single one-time license fee to own the platform, and connect directly to official Meta APIs so you pay Meta at exact wholesale rates.
      </p>
      <p>
        There are no artificial message fees, no multi-year lock-in contracts, and no bloated feature sets you will never touch. Just a rock-solid shared team inbox, verified consent tracking, approved template broadcasts, and in-chat WhatsApp Flows.
      </p>

      <div class="p-6 rounded-2xl bg-surface-50 border border-surface-200 mt-8 space-y-2 text-sm">
        <h3 class="font-bold text-surface-900">Company Information</h3>
        <p><span class="text-surface-500">Legal Entity:</span> <strong>{siteConfig.legalName}</strong></p>
        <p><span class="text-surface-500">Registered Office:</span> {siteConfig.address}</p>
        <p><span class="text-surface-500">Inquiries:</span> <a href={`mailto:${siteConfig.supportEmail}`} class="text-brand-700 hover:underline">{siteConfig.supportEmail}</a></p>
      </div>
    </div>
  </Section>

  <!-- Core Principles Grid -->
  <Section background="default">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-bold uppercase tracking-wider text-brand-700 mb-1">
        Our Operating Principles
      </h2>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-surface-900 tracking-tight">
        What we stand for
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {values.map((v) => (
        <div class="bg-white border border-surface-200 rounded-2xl p-6 sm:p-7 shadow-card">
          <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-200 text-brand-700 flex items-center justify-center mb-4">
            <Icon name={v.icon} class="w-5 h-5" />
          </div>
          <h4 class="text-lg font-bold text-surface-900 mb-2">{v.title}</h4>
          <p class="text-sm text-surface-600 leading-relaxed">{v.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Bottom CTA Band -->
  <Section background="white" class="pt-8">
    <CtaBand />
  </Section>
</Layout>
