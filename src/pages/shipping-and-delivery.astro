---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { siteConfig } from '../config/site';

const lastUpdated = 'October 23, 2026';
---

<Layout
  title={`Shipping & Delivery Policy — ${siteConfig.name}`}
  description={`Digital fulfillment and service delivery policy for ${siteConfig.name} by ${siteConfig.legalName}. Immediate digital software provisioning.`}
>
  <Section background="default" class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto bg-white border border-surface-200 rounded-3xl p-6 sm:p-10 shadow-card">
      <!-- Draft Banner -->
      <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs font-medium mb-8 flex items-center justify-between">
        <span>⚠️ <strong>DRAFT — Pending Formal Legal Review</strong></span>
        <span class="text-amber-700">Last Updated: {lastUpdated}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-surface-900 tracking-tight mb-4">
        Shipping and Delivery Policy
      </h1>

      <div class="prose prose-sm max-w-none text-surface-700 space-y-6 leading-relaxed">
        <p>
          This Shipping and Delivery Policy applies to all purchases of the <strong>{siteConfig.name}</strong> Lifetime Access software license, provided by <strong>{siteConfig.legalName}</strong> ("Company", "we", "us").
        </p>

        <h2 class="text-lg font-bold text-surface-900 pt-4 border-t border-surface-100">
          1. 100% Digital Delivery (No Physical Shipment)
        </h2>
        <p>
          {siteConfig.name} is a purely digital, web-based Software-as-a-Service (SaaS) application hosted in cloud infrastructure. <strong>No physical goods, hardware, USB drives, or paper materials are packaged or shipped to your physical address.</strong>
        </p>

        <h2 class="text-lg font-bold text-surface-900 pt-4 border-t border-surface-100">
          2. Fulfillment Timeline & Method
        </h2>
        <div class="p-4 bg-surface-50 border border-surface-200 rounded-xl space-y-3 text-xs sm:text-sm">
          <p>
            <strong>Instant Provisioning:</strong> Digital access is delivered immediately upon successful completion and verification of payment:
          </p>
          <ul class="list-disc pl-5 space-y-1.5 text-surface-700">
            <li><strong>Automated Dashboard Access:</strong> Upon successful checkout, your account is immediately provisioned and you are redirected directly into the web dashboard at <code>{siteConfig.appUrl}</code>.</li>
            <li><strong>Email Confirmation:</strong> An automated confirmation receipt containing your account activation details and invoice is dispatched immediately to your registered billing email address.</li>
            <li><strong>Delivery Timeframe:</strong> Immediate (typically under 60 seconds from payment authorization).</li>
          </ul>
        </div>

        <h2 class="text-lg font-bold text-surface-900 pt-4 border-t border-surface-100">
          3. Delivery Fees
        </h2>
        <p>
          Because fulfillment is purely digital and electronic, <strong>no shipping, handling, or courier charges apply</strong> to any order.
        </p>

        <h2 class="text-lg font-bold text-surface-900 pt-4 border-t border-surface-100">
          4. Troubleshooting Delayed Access
        </h2>
        <p>
          If you have completed your payment transaction but have not received your account confirmation email or cannot access the dashboard within 15 minutes:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm">
          <li>Check your email spam / junk or promotions folder for the receipt.</li>
          <li>Ensure your payment was successfully debited from your card or bank account.</li>
          <li>Contact our priority support desk with your payment reference ID at <a href={`mailto:${siteConfig.supportEmail}`} class="text-brand-700 underline">{siteConfig.supportEmail}</a> and we will verify your workspace manually within a few hours.</li>
        </ul>

        <h2 class="text-lg font-bold text-surface-900 pt-4 border-t border-surface-100">
          5. Company Identification
        </h2>
        <p>
          <strong>{siteConfig.legalName}</strong><br/>
          {siteConfig.address}<br/>
          Contact email: <a href={`mailto:${siteConfig.supportEmail}`} class="text-brand-700 underline">{siteConfig.supportEmail}</a>
        </p>
      </div>
    </div>
  </Section>
</Layout>
