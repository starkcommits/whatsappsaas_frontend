---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../config/site';
---

<Layout
  title={`Page Not Found (404) — ${siteConfig.name}`}
  description="The page you requested could not be found."
>
  <Section background="default" class="py-20 md:py-32 text-center">
    <div class="max-w-xl mx-auto space-y-6">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-50 text-brand-700 border border-brand-200 text-xl font-bold font-mono">
        404
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-surface-900 tracking-tight">
        Page Not Found
      </h1>

      <p class="text-base text-surface-600 leading-relaxed">
        The link you followed may be broken or the page may have been moved. Return to our homepage or explore our platform features below.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <Button href="/" size="lg" class="w-full sm:w-auto font-semibold">
          Return to Home
        </Button>
        <Button href="/pricing" variant="secondary" size="lg" class="w-full sm:w-auto">
          View Lifetime Pricing ($50)
        </Button>
      </div>

      <div class="pt-8 border-t border-surface-200/80 text-xs text-surface-500">
        Looking for assistance? <a href="/contact" class="text-brand-700 font-semibold hover:underline">Contact our support desk</a>.
      </div>
    </div>
  </Section>
</Layout>
