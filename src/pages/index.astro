---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ProductFrame from '../components/ProductFrame.astro';
import InboxMockup from '../components/mockups/InboxMockup.astro';
import ConsentMockup from '../components/mockups/ConsentMockup.astro';
import TemplateMockup from '../components/mockups/TemplateMockup.astro';
import CampaignMockup from '../components/mockups/CampaignMockup.astro';
import ApiWebhooksCard from '../components/ApiWebhooksCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroSampleConversations from '../islands/HeroSampleConversations';
import HeroRotator from '../islands/HeroRotator';
import TabbedTour from '../islands/TabbedTour';
import PricingCard from '../islands/PricingCard';
import FaqAccordion from '../islands/FaqAccordion';
import { homeFAQ } from '../data/faq';
import { lifetimePlan } from '../data/plans';
import { siteConfig } from '../config/site';

const steps = [
  {
    step: '01',
    title: 'Connect number',
    desc: 'Link your business phone number via Meta Embedded Signup in a few clicks.',
  },
  {
    step: '02',
    title: 'Import contacts with consent',
    desc: 'Upload CSV lists with verified opt-in sources and assign targeted audience tags.',
  },
  {
    step: '03',
    title: 'Send template campaigns',
    desc: 'Compose approved Meta templates, add dynamic variables, and schedule delivery.',
  },
  {
    step: '04',
    title: 'Reply from shared inbox',
    desc: 'Triage customer inquiries, assign chats to teammates, and answer with canned replies.',
  },
];

const outcomes = [
  {
    title: 'Never lose track of a customer conversation',
    desc: 'Replace chaotic personal phones with a shared workspace. Multiple agents work the inbox simultaneously, assign chats, and leave private internal notes.',
    tag: 'Shared Inbox',
  },
  {
    title: 'Broadcast campaigns without getting banned',
    desc: 'Deliver approved Meta message templates only to contacts with verified opt-in. Inbound STOP replies automatically unsubscribe contacts from future broadcasts.',
    tag: 'Consent Ledger',
  },
  {
    title: 'Protect your margins with zero markup',
    desc: 'Pay a one-time software license. Connect directly to Meta\'s Cloud API and pay Meta at their baseline rates, with zero middleman per-message fees.',
    tag: 'Direct Meta Rates',
  },
];

const useCasePreviews = [
  { title: 'Retail & D2C Brands', desc: 'Dispatch order notifications, handle customer inquiries, and launch seasonal campaigns.' },
  { title: 'Clinics & Healthcare', desc: 'Manage patient appointments, send reminders, and collect intake forms via WhatsApp Flows.' },
  { title: 'Education & Coaching', desc: 'Coordinate batch admissions, answer syllabus questions, and announce intake deadlines.' },
  { title: 'Real Estate & Services', desc: 'Route property inquiries to specific agents and schedule site visits with in-chat forms.' },
];

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  description: siteConfig.description,
};
---

<Layout
  title={`${siteConfig.name} — Calm, reliable WhatsApp operations for growing teams`}
  description={siteConfig.description}
  jsonLd={homeJsonLd}
>
  <!-- 1. Hero Section -->
  <section class="relative pt-12 pb-18 sm:pt-20 sm:pb-24 border-b border-ink-100 bg-ink-50/50 overflow-hidden">
    <!-- Subtle Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#E8ECF0_1px,transparent_1px),linear-gradient(to_bottom,#E8ECF0_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-40 pointer-events-none"></div>

    <!-- Animated Sample Conversation Chips in Background (React Island) -->
    <HeroSampleConversations client:idle />

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Hero Copy (Core ONO Value Proposition with Animated Rotator) -->
        <div class="lg:col-span-6 space-y-6 text-left">
          
          <!-- One-Time License & Zero Markup Badge -->
          <div>
            <Button
              href="/pricing"
              variant="secondary"
              size="sm"
              class="gap-2.5 rounded-full px-4 text-xs font-mono font-medium text-ink-800 bg-white hover:bg-ink-50 border border-ink-200/80 shadow-soft"
            >
              <span class="w-2 h-2 rounded-full bg-brand-500 shrink-0"></span>
              <span>One-time license: ${lifetimePlan.priceUSD} ({lifetimePlan.priceINRFormatted}) • Zero message markup</span>
              <svg class="w-3.5 h-3.5 text-ink-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </Button>
          </div>

          <!-- Headline with Animated Rotating Core Capabilities -->
          <div class="flex gap-4 flex-col">
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.2rem] xl:text-[2.5rem] font-extrabold text-ink-950 font-display tracking-tight leading-[1.18]">
              <span class="block text-ink-950">Every customer conversation on WhatsApp,</span>
              <HeroRotator client:load />
            </h1>

            <!-- Subheading paragraph grounded in AGENTS.md -->
            <p class="text-base sm:text-lg leading-relaxed tracking-tight text-ink-500 max-w-2xl font-normal">
              ONO helps your team connect your business WhatsApp number via Meta Cloud API, broadcast template campaigns to contacts who agreed, and reply together from a shared team inbox. Pay once for lifetime access. No monthly subscription, and zero per-message markup.
            </p>
          </div>

          <!-- Primary & Secondary CTAs -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
            <Button
              href={siteConfig.links.signup}
              variant="primary"
              size="lg"
              class="gap-3 font-semibold shadow-soft"
              isAppCta={true}
            >
              <span>Get lifetime access (${lifetimePlan.priceUSD})</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </Button>

            <Button
              href="#how-it-works"
              variant="secondary"
              size="lg"
              class="gap-3 font-semibold shadow-soft"
            >
              <span>See how it works</span>
              <svg class="w-4 h-4 text-ink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="10 8 16 12 10 16 10 8"></polygon>
              </svg>
            </Button>
          </div>

          <!-- 4-Item Fact Strip -->
          <div class="pt-6 border-t border-ink-100 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-ink-700">
            <div class="flex items-center gap-1.5 font-medium">
              <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Pay once</span>
            </div>
            <div class="flex items-center gap-1.5 font-medium">
              <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>No message markup</span>
            </div>
            <div class="flex items-center gap-1.5 font-medium">
              <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>7-day refund</span>
            </div>
            <div class="flex items-center gap-1.5 font-medium">
              <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Consent built in</span>
            </div>
          </div>

          <p class="text-xs text-ink-500 font-mono">
            Built on Meta's WhatsApp Business Platform (Cloud API).
          </p>

        </div>

        <!-- Right Hero Visual with Layered ProductFrame & Floating Chips -->
        <div class="lg:col-span-6 relative">
          
          <!-- Floating Sample Data Chip: Top Right -->
          <div class="hidden sm:flex items-center gap-2 absolute -top-4 -right-4 z-20 bg-white border border-ink-100 shadow-soft-lg px-3 py-1.5 rounded-xl text-xs font-medium text-ink-900">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Template approved</span>
            <span class="text-[10px] font-mono text-ink-400">Sample data</span>
          </div>

          <!-- Floating Sample Data Chip: Bottom Left -->
          <div class="hidden sm:flex items-center gap-2 absolute -bottom-4 -left-4 z-20 bg-white border border-ink-100 shadow-soft-lg px-3 py-1.5 rounded-xl text-xs font-medium text-ink-900">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            <span>Consent: website form</span>
            <span class="text-[10px] font-mono text-ink-400">Sample data</span>
          </div>

          <!-- Main Hero Inbox ProductFrame -->
          <ProductFrame path="/whatsapp/inbox/+919876543210/" caption="Sample data • ONO dashboard inbox preview">
            <InboxMockup />
          </ProductFrame>

        </div>

      </div>
    </div>
  </section>

  <!-- 2. "From scattered chats to one workflow" (3 Outcome Cards) -->
  <Section background="white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 mb-2">
          Operational Clarity
        </h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-ink-950 font-display tracking-tight">
          From scattered chats to one workflow
        </h3>
        <p class="text-sm sm:text-base text-ink-500 mt-3 leading-relaxed">
          Centralize your incoming messages, template broadcasts, and contact lists into one structured workspace.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {outcomes.map((item) => (
          <div class="rounded-2xl border border-ink-100 bg-ink-50/50 p-6 sm:p-8 flex flex-col justify-between shadow-soft hover:border-ink-200 transition-all duration-150">
            <div class="space-y-3">
              <span class="text-[10px] font-mono font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-white text-ink-700 border border-ink-100">
                {item.tag}
              </span>
              <h4 class="text-xl font-bold text-ink-950 font-display leading-snug">
                {item.title}
              </h4>
              <p class="text-xs sm:text-sm text-ink-500 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- 3. Dark Ink Section: Tabbed Tour (React Island via Radix Tabs with ARIA Keyboard Support) -->
  <TabbedTour client:visible id="tour">
    <div slot="inbox">
      <ProductFrame path="/whatsapp/inbox/+919876543210/" caption="Sample data • Live inbox mockup">
        <InboxMockup />
      </ProductFrame>
    </div>
    <div slot="templates">
      <ProductFrame path="/templates" caption="Sample data • Template editor preview">
        <TemplateMockup />
      </ProductFrame>
    </div>
    <div slot="campaigns">
      <ProductFrame path="/campaigns" caption="Sample data • Campaign reporting dashboard">
        <CampaignMockup />
      </ProductFrame>
    </div>
    <div slot="consent">
      <ProductFrame path="/consent" caption="Sample data • Consent tracking ledger">
        <ConsentMockup />
      </ProductFrame>
    </div>
  </TabbedTour>

  <!-- 4. API & Webhooks Strip (Zero Logos) -->
  <ApiWebhooksCard />

  <!-- 5. How It Works Timeline (4 Steps) -->
  <Section id="how-it-works" background="white" class="border-b border-ink-100">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 mb-2">
          Simple 4-Step Process
        </h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-ink-950 font-display tracking-tight">
          How ONO works
        </h3>
        <p class="text-sm sm:text-base text-ink-500 mt-2">
          From connecting your number to broadcasting your first campaign.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {steps.map((item) => (
          <div class="bg-ink-50 border border-ink-100 rounded-2xl p-6 relative flex flex-col justify-between shadow-soft">
            <div>
              <div class="text-2xl font-black font-mono text-brand-600 mb-3">
                {item.step}
              </div>
              <h4 class="text-base font-bold text-ink-950 font-display mb-2">
                {item.title}
              </h4>
              <p class="text-xs sm:text-sm text-ink-500 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href="/how-it-works"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:text-brand-800 underline underline-offset-4"
        >
          <span>Read detailed onboarding guide</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </Section>

  <!-- 6. Consent & Compliance Spotlight -->
  <Section background="default" class="border-b border-ink-100">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-5 space-y-4">
          <span class="inline-flex items-center text-xs font-mono font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-100">
            Compliance First
          </span>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-ink-950 font-display tracking-tight leading-tight">
            Consent tracking that protects your number
          </h3>
          <p class="text-sm sm:text-base text-ink-500 leading-relaxed">
            Meta monitors recipient block and spam rates closely. ONO protects your business phone number with automated opt-in tracking and instant STOP keyword handling.
          </p>

          <ul class="space-y-2.5 pt-2 text-xs sm:text-sm text-ink-700">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-brand-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Opt-in links & QR codes for websites and store counters</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-brand-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Automatic unsubscribe when customers reply STOP</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-brand-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Exportable proof of consent ledger for compliance reviews</span>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-7">
          <ProductFrame path="/compliance" caption="Sample data • Consent tracking ledger">
            <ConsentMockup />
          </ProductFrame>
        </div>

      </div>
    </div>
  </Section>

  <!-- 7. Pricing & Two-Column Comparison -->
  <Section background="white">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 mb-2">
          Straightforward Pricing
        </h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-ink-950 font-display tracking-tight">
          One payment. Zero recurring fees.
        </h3>
        <p class="text-sm sm:text-base text-ink-500 mt-2">
          No monthly tiers. You own the software and pay Meta directly for messaging.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <PricingCard client:visible showFullDetails={false} />
      </div>

      <div class="max-w-5xl mx-auto pt-6">
        <ComparisonTable />
      </div>
    </div>
  </Section>

  <!-- 8. Security & Tenancy Summary -->
  <Section background="default" class="border-y border-ink-100">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7 space-y-3">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 bg-brand-50 border border-brand-100 px-3 py-1 rounded-full">
          Security & Tenancy
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-ink-950 font-display tracking-tight">
          Built for privacy and data isolation
        </h3>
        <p class="text-sm text-ink-500 leading-relaxed">
          Two-factor authentication for workspace owners, strict tenant database isolation, hashed API keys, encrypted Meta credentials, and unalterable audit logging.
        </p>
      </div>
      <div class="md:col-span-5 flex flex-col sm:flex-row md:flex-col gap-3 justify-end">
        <a
          href="/security"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-white border border-ink-100 text-xs sm:text-sm font-semibold text-ink-900 shadow-soft hover:bg-ink-50 transition-colors"
        >
          View security architecture →
        </a>
      </div>
    </div>
  </Section>

  <!-- 9. Use Cases Preview -->
  <Section background="white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 mb-2">
          Use Cases
        </h2>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-ink-950 font-display tracking-tight">
          Workflows across industries
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {useCasePreviews.map((uc) => (
          <div class="p-5 rounded-2xl bg-ink-50 border border-ink-100 space-y-2">
            <h4 class="text-sm font-bold text-ink-950 font-display">{uc.title}</h4>
            <p class="text-xs text-ink-500 leading-relaxed">{uc.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/use-cases" class="text-xs font-semibold text-brand-700 hover:text-brand-800 underline underline-offset-4">
          Explore all industry use cases →
        </a>
      </div>
    </div>
  </Section>

  <!-- 10. FAQ & Final CTA Band -->
  <Section background="default" class="border-t border-ink-100">
    <div class="max-w-4xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 mb-2">
          FAQ
        </h2>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-ink-950 font-display tracking-tight">
          Frequently asked questions
        </h3>
      </div>

      <FaqAccordion client:visible items={homeFAQ} />
    </div>
  </Section>

  <!-- Final CTA Band -->
  <Section background="white">
    <CtaBand />
  </Section>
</Layout>
