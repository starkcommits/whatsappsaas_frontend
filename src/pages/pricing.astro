---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PricingCard from '../components/PricingCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { lifetimePlan } from '../data/plans';
import { pricingFAQ } from '../data/faq';
import { siteConfig } from '../config/site';

const pricingJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${siteConfig.name} Lifetime License`,
    description: siteConfig.description,
    brand: {
      '@type': 'Brand',
      name: siteConfig.name,
    },
    offers: {
      '@type': 'Offer',
      price: lifetimePlan.priceUSD.toString(),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: `${siteConfig.siteUrl}/pricing`,
      priceValidUntil: '2027-12-31',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: pricingFAQ.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`Pricing — ${siteConfig.name} Lifetime Access ($${lifetimePlan.priceUSD}${lifetimePlan.priceINR ? ` / ₹${lifetimePlan.priceINR.toLocaleString('en-IN')}` : ''})`}
  description={`Pay once, use forever. $${lifetimePlan.priceUSD} one-time license for ONO WhatsApp Business platform. No monthly subscription, zero markup on WhatsApp messages.`}
  jsonLd={pricingJsonLd}
>
  <!-- Hero Section -->
  <section class="py-16 md:py-20 bg-gradient-to-b from-brand-50/50 via-surface-50 to-surface-50 border-b border-surface-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-2 bg-brand-100/80 text-brand-900 border border-brand-200 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold mb-4">
        <span>One-Time Software License</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-surface-900 tracking-tight leading-tight">
        One clear price. Lifetime access. Zero message markup.
      </h1>
      <p class="text-base sm:text-lg text-surface-600 mt-4 leading-relaxed">
        Say goodbye to costly per-seat monthly subscriptions. Own the software for life, connect your own WhatsApp number, and pay Meta directly.
      </p>
    </div>
  </section>

  <!-- Pricing Card Section -->
  <Section background="default" class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto">
      <PricingCard showFullDetails={true} />
    </div>
  </Section>

  <!-- Explainer Section: "What does Meta charge?" -->
  <Section background="white">
    <div class="max-w-4xl mx-auto">
      <div class="bg-surface-50 border border-surface-200 rounded-3xl p-8 sm:p-10 space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold">
            <Icon name="tag" class="w-5 h-5" />
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-surface-900 tracking-tight">
              What does Meta charge for WhatsApp messages?
            </h2>
            <p class="text-xs sm:text-sm text-surface-500">
              Understanding official Meta WhatsApp Cloud API conversation pricing.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-sm text-surface-700 leading-relaxed border-t border-surface-200 pt-5">
          <p>
            When using the official WhatsApp Business Platform, Meta charges businesses on a per-conversation basis (within a 24-hour customer window). <strong>Rates are set directly by Meta</strong> and vary depending on:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
            <div class="p-4 bg-white rounded-xl border border-surface-200">
              <h4 class="font-bold text-surface-900 text-xs uppercase tracking-wider mb-1">1. Recipient Country</h4>
              <p class="text-xs text-surface-600">
                Meta sets country-specific rates based on the recipient's country code (e.g., India, United States, United Kingdom, Brazil, UAE, etc.).
              </p>
            </div>

            <div class="p-4 bg-white rounded-xl border border-surface-200">
              <h4 class="font-bold text-surface-900 text-xs uppercase tracking-wider mb-1">2. Conversation Category</h4>
              <p class="text-xs text-surface-600">
                Marketing, Utility (order tracking, confirmations), Authentication (OTPs), or Service (inbound user-initiated customer support).
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-950 text-xs sm:text-sm">
            <p class="font-bold mb-1">
              Why ONO's zero-markup model saves you thousands:
            </p>
            <p class="leading-relaxed">
              Most SaaS competitors add a 20% to 100% markup on top of Meta's rates or charge an extra fee per outbound message. With {siteConfig.name}, you connect your own payment method inside your Meta Business Manager. Meta bills you directly at wholesale cost, and ONO takes <strong>$0.00 markup</strong> on your messages.
            </p>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <p class="text-xs text-surface-500">
              Check the latest official per-conversation rate cards published by Meta:
            </p>
            <a
              href="https://business.whatsapp.com/pricing"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-900 hover:underline bg-white border border-brand-200 px-3 py-2 rounded-lg shrink-0 shadow-2xs"
            >
              <span>View Official Meta Pricing Rates ↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Comparison-Free FAQ -->
  <Section background="default">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-bold uppercase tracking-wider text-brand-700 mb-2">
        Common Questions
      </h2>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-surface-900 tracking-tight">
        Pricing & Lifetime Terms FAQ
      </h3>
      <p class="text-surface-600 text-sm sm:text-base mt-2">
        Everything you need to know about our lifetime guarantee, refunds, and getting started.
      </p>
    </div>

    <FaqAccordion items={pricingFAQ} />
  </Section>

  <!-- Bottom CTA Band -->
  <Section background="default" class="pt-0">
    <CtaBand />
  </Section>
</Layout>
