---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PricingCard from '../islands/PricingCard';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../islands/FaqAccordion';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { pricingFAQ } from '../data/faq';
import { lifetimePlan } from '../data/plans';
import { siteConfig } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${siteConfig.name} - Lifetime Access`,
  description: lifetimePlan.billingText,
  offers: {
    '@type': 'Offer',
    price: lifetimePlan.priceUSD,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: siteConfig.siteUrl,
  },
};
---

<Layout
  title={`Transparent Pricing — $${lifetimePlan.priceUSD} Lifetime Access`}
  description={`Pay once for lifetime access to ${siteConfig.name}. $${lifetimePlan.priceUSD} (${lifetimePlan.priceINRFormatted}). No monthly subscription, zero markup on WhatsApp conversation fees.`}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-[#E7F8EE] via-[#F2FAF5] to-white border-b border-emerald-100/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 bg-brand-50 border border-brand-100 px-3.5 py-1 rounded-full mb-4">
        <span>One-Time Licensing</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-950 tracking-tight font-display leading-tight">
        Simple, transparent lifetime pricing
      </h1>
      <p class="text-base sm:text-lg text-ink-500 mt-4 leading-relaxed">
        One plan. One payment. Own the software for your team with zero monthly platform subscriptions and zero per-message markup.
      </p>
    </div>
  </section>

  <!-- Pricing Card Section -->
  <Section background="white">
    <div class="max-w-4xl mx-auto">
      <PricingCard client:visible showFullDetails={true} />
    </div>
  </Section>

  <!-- Who Pays What Breakdown -->
  <Section background="default" id="meta-rates">
    <div class="max-w-5xl mx-auto">
      <ComparisonTable />
    </div>
  </Section>

  <!-- Meta Messaging Charges Explainer -->
  <Section background="white">
    <div class="max-w-4xl mx-auto">
      <div class="rounded-3xl border border-ink-100 bg-ink-50/40 p-6 sm:p-10 space-y-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center shrink-0 mt-1 border border-brand-100">
            <Icon name="tag" class="w-5 h-5" />
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-ink-950 font-display tracking-tight">
              What does Meta charge for WhatsApp messages?
            </h2>
            <p class="text-xs sm:text-sm text-ink-500 mt-1">
              Understanding Meta's WhatsApp Cloud API conversation pricing.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-sm text-ink-700 leading-relaxed border-t border-ink-100 pt-5">
          <p>
            When using Meta's WhatsApp Business Platform (Cloud API), Meta charges businesses on a per-conversation basis (within a 24-hour customer window). <strong>Rates are set directly by Meta</strong> and vary depending on:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
            <div class="p-4 bg-white rounded-xl border border-ink-100">
              <h3 class="font-bold text-ink-950 text-xs uppercase tracking-wider mb-1 font-mono">1. Recipient Country</h3>
              <p class="text-xs text-ink-600 leading-relaxed">
                Meta sets country-specific rates based on the recipient's country code (e.g., India, United States, United Kingdom, UAE, etc.).
              </p>
            </div>

            <div class="p-4 bg-white rounded-xl border border-ink-100">
              <h3 class="font-bold text-ink-950 text-xs uppercase tracking-wider mb-1 font-mono">2. Conversation Category</h3>
              <p class="text-xs text-ink-600 leading-relaxed">
                Marketing, Utility (order tracking, confirmations), Authentication (OTPs), or Service (inbound customer inquiries).
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-brand-50/70 border border-brand-100 text-ink-900 text-xs sm:text-sm">
            <p class="font-bold mb-1 text-brand-900">
              Why ONO's zero-markup model saves you money:
            </p>
            <p class="leading-relaxed text-ink-700">
              Most SaaS competitors add markups on top of Meta's rates or charge extra per outbound message. With {siteConfig.name}, you connect your own payment method inside your Meta Business Manager. Meta bills you directly, and ONO takes <strong>zero markup</strong> on your messages.
            </p>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <p class="text-xs text-ink-600">
              Check the latest conversation rate cards published by Meta:
            </p>
            <a
              href="https://business.whatsapp.com/pricing"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-900 hover:underline bg-white border border-brand-100 px-3.5 py-2 rounded-lg shrink-0 shadow-soft"
            >
              <span>View Meta Conversation Pricing Rates ↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Comparison-Free FAQ -->
  <Section background="default" id="faq">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-flex items-center text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 bg-brand-50 border border-brand-100 px-3.5 py-1 rounded-full mb-3">
        Clear Answers
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink-950 font-display tracking-tight">
        Frequently asked pricing questions
      </h2>
      <p class="text-sm text-ink-600 mt-2">
        Everything you need to know about the lifetime license, billing, and refunds.
      </p>
    </div>

    <FaqAccordion client:visible items={pricingFAQ} />
  </Section>

  <!-- Final CTA Band -->
  <Section background="white">
    <CtaBand />
  </Section>
</Layout>
