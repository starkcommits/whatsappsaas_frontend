---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import InboxMockup from '../components/mockups/InboxMockup.astro';
import { siteConfig } from '../config/site';

const prerequisites = [
  {
    title: 'A Meta Business Account',
    desc: 'A verified or standard Meta Business Account (business.facebook.com). If you run Facebook or Instagram ads, you likely already have one.',
    icon: 'connect',
  },
  {
    title: 'A Dedicated Phone Number',
    desc: 'A mobile or landline number that can receive an SMS or voice OTP code. It must not currently be registered on the consumer WhatsApp or WhatsApp Business mobile app.',
    icon: 'inbox',
  },
  {
    title: 'A Valid Payment Method in Meta',
    desc: 'You link your own credit or debit card directly inside Meta Business Manager so Meta can bill you at their official conversation rates with zero markup.',
    icon: 'tag',
  },
];

const onboardingSteps = [
  {
    step: 'Step 1',
    title: 'Create your ONO Workspace',
    description: 'Claim your lifetime license and access your new dashboard immediately. Invite up to 3 team members (Owner, Admin, Agent).',
    bullets: [
      'Instant account creation with email login',
      'Assign team member roles and permissions',
      'Generate secure REST API keys and configure webhook endpoints'
    ]
  },
  {
    step: 'Step 2',
    title: 'Connect your Phone Number via Meta Embedded Signup',
    description: 'Click "Connect WhatsApp" in your dashboard to open the official Meta popup. Log into your Meta account and select or register your business phone number.',
    bullets: [
      'Official Meta popup dialog handles all authentication',
      'No complicated Cloud API tokens or server hosting needed',
      'Your phone number connects directly to your WhatsApp Business Account (WABA)'
    ]
  },
  {
    step: 'Step 3',
    title: 'Import Contacts with Verifiable Consent Sources',
    description: 'Upload your existing customer base using our CSV importer. Map column fields for phone numbers, customer names, custom tags, and required consent origins.',
    bullets: [
      'Mandatory consent source logging for compliance',
      'Assign tags (e.g. "VIP Client", "Bangalore Store", "Web Lead")',
      'Automated suppression list filters out any prior opt-outs'
    ]
  },
  {
    step: 'Step 4',
    title: 'Draft & Submit Meta Message Templates',
    description: 'Compose outbound templates in our live preview builder. Add headers, dynamic variables {{1}}, {{2}}, and interactive CTA or quick-reply buttons.',
    bullets: [
      'Direct one-click submission to Meta for automated review',
      'Live WYSIWYG mobile chat bubble preview',
      'Approval status synced directly in your dashboard within minutes'
    ]
  },
  {
    step: 'Step 5',
    title: 'Schedule Campaigns & Reply from the Shared Inbox',
    description: 'Pick an approved template, select your audience segment, and schedule your broadcast. As customers reply, your team handles chats from the shared inbox.',
    bullets: [
      'Track Sent, Delivered, Read, and Inbound Replies in real time',
      'Assign incoming chats to teammates and add private internal notes',
      'Instant one-click canned replies for rapid resolution'
    ]
  }
];
---

<Layout
  title={`How It Works — ${siteConfig.name} WhatsApp Business Onboarding`}
  description="Learn step-by-step how to set up ONO: prerequisites, connecting your WhatsApp number via Meta Embedded Signup, importing contacts, and sending campaigns."
>
  <!-- Header -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-brand-50/50 via-surface-50 to-surface-50 border-b border-surface-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-700 bg-brand-100/70 border border-brand-200 px-3.5 py-1 rounded-full mb-4">
        <span>Onboarding Guide</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-surface-900 tracking-tight leading-tight">
        How to get up and running with {siteConfig.name}
      </h1>
      <p class="text-base sm:text-lg text-surface-600 mt-4 leading-relaxed">
        Everything you need to know about setting up your WhatsApp Business account, connecting your number, and launching your first broadcast.
      </p>
    </div>
  </section>

  <!-- Prerequisites Checklist -->
  <Section background="white">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-xs font-bold uppercase tracking-wider text-brand-700 mb-1">
          What you need to start
        </h2>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-surface-900 tracking-tight">
          Three Simple Prerequisites
        </h3>
        <p class="text-xs sm:text-sm text-surface-600 mt-2">
          Make sure you have these ready before connecting your business number.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {prerequisites.map((item) => (
          <div class="bg-surface-50 border border-surface-200 rounded-2xl p-6 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-200 text-brand-700 flex items-center justify-center mb-4">
                <Icon name={item.icon} class="w-5 h-5" />
              </div>
              <h4 class="text-base font-bold text-surface-900 mb-2">
                {item.title}
              </h4>
              <p class="text-xs sm:text-sm text-surface-600 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Detailed Onboarding Steps -->
  <Section background="default">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-xs font-bold uppercase tracking-wider text-brand-700 mb-1">
          Step-by-Step Flow
        </h2>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-surface-900 tracking-tight">
          From Sign Up to First Campaign
        </h3>
      </div>

      <div class="space-y-8 relative before:absolute before:inset-0 before:left-8 md:before:left-1/2 before:w-0.5 before:bg-surface-200 before:hidden md:before:block">
        {onboardingSteps.map((step) => (
          <div class="bg-white rounded-2xl border border-surface-200 p-6 sm:p-8 shadow-card hover:border-brand-300 transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-xs font-mono font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200 px-3 py-1 rounded-full">
                {step.step}
              </span>
              <h4 class="text-xl font-bold text-surface-900">
                {step.title}
              </h4>
            </div>

            <p class="text-sm text-surface-600 leading-relaxed mb-4">
              {step.description}
            </p>

            <ul class="space-y-2 border-t border-surface-100 pt-4 text-xs text-surface-700">
              {step.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-brand-600 mt-0.5">
                    <Icon name="check" class="w-3.5 h-3.5" />
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Product Mockup Section -->
  <Section background="white">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h3 class="text-2xl sm:text-3xl font-extrabold text-surface-900 tracking-tight">
        Your Team's Central Command Center
      </h3>
      <p class="text-sm text-surface-600 mt-2">
        A clean, distraction-free interface for your entire team to collaborate on WhatsApp.
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <DeviceFrame browserUrl="https://app.flexing.in/inbox">
        <InboxMockup />
      </DeviceFrame>
    </div>
  </Section>

  <!-- Bottom CTA Band -->
  <Section background="default" class="pt-8">
    <CtaBand />
  </Section>
</Layout>
