---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { siteConfig } from '../config/site';
import { lifetimePlan } from '../data/plans';

const lastUpdated = 'October 24, 2026';
---

<Layout
  title={`Refund and Cancellation Policy — ${siteConfig.name}`}
  description={`Official 7-day unconditional money-back guarantee policy for ${siteConfig.name} lifetime software license by ${siteConfig.legalName}. Learn how to request a full refund.`}
>
  <Section background="default" class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto bg-white border border-surface-200 rounded-3xl p-6 sm:p-10 shadow-card">
      
      <!-- Official Policy Notice Banner -->
      <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-950 text-xs font-medium mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <span class="flex items-center gap-1.5">
          <span class="size-2 rounded-full bg-emerald-500 inline-block"></span>
          <strong>Official Refund & Cancellation Policy · 7-Day Guarantee</strong>
        </span>
        <span class="text-emerald-700 font-mono text-[11px]">Last Updated: {lastUpdated}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-surface-900 tracking-tight mb-2">
        Refund and Cancellation Policy
      </h1>
      <p class="text-xs sm:text-sm text-surface-500 mb-8 pb-6 border-b border-surface-100">
        <strong>{siteConfig.legalName}</strong> · {siteConfig.address} · Effective: {lastUpdated}
      </p>

      <div class="prose prose-sm max-w-none text-surface-700 space-y-6 leading-relaxed">
        <p>
          At <strong>{siteConfig.legalName}</strong> (“Company”, “we”, “us”), we stand behind the reliability, performance, and transparency of <strong>{siteConfig.name}</strong>. We want every business owner and team to evaluate our software with complete confidence.
        </p>
        <p>
          This Refund and Cancellation Policy governs all purchases of the {siteConfig.name} Lifetime Access software license made through <a href={`https://${siteConfig.domain}`} class="text-brand-700 underline font-medium">{siteConfig.domain}</a> or our authorized checkout gateways.
        </p>

        <!-- 1. 7-Day Unconditional Money-Back Guarantee -->
        <h2 class="text-lg font-bold text-surface-900 pt-6 border-t border-surface-100">
          1. 7-Day Unconditional Money-Back Guarantee
        </h2>
        <div class="p-4 bg-surface-50 border border-surface-200 rounded-2xl text-xs sm:text-sm space-y-2">
          <p class="font-bold text-surface-900">100% Full Refund Within 7 Days:</p>
          <p>
            If you purchase the {siteConfig.name} Lifetime Access license and decide within <strong>seven (7) calendar days</strong> from your transaction timestamp that the platform does not meet your business requirements, you are entitled to a full 100% refund of your one-time software license fee of ${lifetimePlan.priceUSD}{lifetimePlan.priceINR ? ` (₹${lifetimePlan.priceINR.toLocaleString('en-IN')})` : ''}.
          </p>
          <p class="text-surface-600">
            No questions asked, no hidden cancellation charges, and no retention lock-ins.
          </p>
        </div>

        <!-- 2. Step-by-Step Refund Request Process -->
        <h2 class="text-lg font-bold text-surface-900 pt-6 border-t border-surface-100">
          2. How to Request a Refund
        </h2>
        <p>
          To ensure rapid verification and fraud prevention, refund requests must be submitted in writing from the registered email address associated with your workspace:
        </p>
        <div class="p-4 bg-surface-50 border border-surface-200 rounded-2xl space-y-2 text-xs sm:text-sm">
          <p><strong>Send Email To:</strong> <a href={`mailto:${siteConfig.supportEmail}`} class="text-brand-700 underline font-medium">{siteConfig.supportEmail}</a></p>
          <p><strong>Subject Line:</strong> Refund Request — [Your Workspace Name or Order ID]</p>
          <p><strong>Please Include in the Body:</strong></p>
          <ul class="list-disc pl-5 space-y-1 text-surface-600">
            <li>Registered account email address</li>
            <li>Order ID or Payment Gateway Transaction Reference ID (from Razorpay / Stripe receipt)</li>
            <li>Date of transaction</li>
            <li>(Optional) Brief feedback on why ONO did not fit your workflow (helps our engineering team)</li>
          </ul>
        </div>

        <!-- 3. Refund Processing Timeline & Payment Reversals -->
        <h2 class="text-lg font-bold text-surface-900 pt-6 border-t border-surface-100">
          3. Refund Processing Timeline & Payment Reversal Mechanics
        </h2>
        <p>
          Once your written request is received:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
          <li>
            <strong>Written Acknowledgment:</strong> Our finance team will acknowledge and log your request within <strong>twenty-four (24) business hours</strong>.
          </li>
          <li>
            <strong>Original Payment Source Only:</strong> In strict compliance with Reserve Bank of India (RBI) guidelines and global anti-money laundering (AML) laws, all refunds are initiated exclusively to the <strong>original payment method</strong> used during checkout (e.g., the originating UPI ID, debit card, credit card, or net banking account). We do not issue cash refunds or transfers to third-party bank accounts.
          </li>
          <li>
            <strong>Bank Credit Timelines:</strong>
            <ul class="list-circle pl-5 mt-1 space-y-1 text-surface-600">
              <li><strong>UPI / Instant Net Banking:</strong> Typically credited within 24 to 48 hours of approval.</li>
              <li><strong>Credit / Debit Cards:</strong> Typically reflected in your account statement within 5 to 7 business days, subject to your card-issuing bank’s clearing cycle.</li>
            </ul>
          </li>
        </ul>

        <!-- 4. Cancellation of Service & Data Export -->
        <h2 class="text-lg font-bold text-surface-900 pt-6 border-t border-surface-100">
          4. Cancellation of Service & Data Export Rights
        </h2>
        <p>
          Because {siteConfig.name} operates on a one-time software license model, <strong>there are no ongoing monthly or annual subscription fees to cancel</strong>. You will never be billed automatically for future platform usage.
        </p>
        <p>
          Upon approval and initiation of a refund within the 7-day window:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm">
          <li>Your workspace license, dashboard credentials, and API tokens will be deactivated.</li>
          <li>We strongly recommend that you utilize the built-in <strong>CSV Data Export</strong> tool in your dashboard settings to export all contact registries, opt-in consent records, and message logs prior to requesting a refund.</li>
          <li>In accordance with our <a href="/privacy" class="text-brand-700 underline font-medium">Privacy Policy</a>, workspace data is scheduled for permanent purge following account deactivation.</li>
        </ul>

        <!-- 5. Meta Message Costs are Non-Refundable -->
        <h2 class="text-lg font-bold text-surface-900 pt-6 border-t border-surface-100">
          5. Meta Conversation Charges are Non-Refundable by ONO
        </h2>
        <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-950">
          <strong>Important Notice on Telephony Fees:</strong> Any conversation-based message fees billed directly by Meta Platforms, Inc. for marketing broadcasts, utility alerts, authentication, or service messages are paid directly to Meta via your Meta Business Manager. {siteConfig.legalName} never marks up or collects these fees, and cannot issue refunds or credits for charges billed by Meta.
        </div>

        <!-- 6. Payment Disputes & Chargebacks -->
        <h2 class="text-lg font-bold text-surface-900 pt-6 border-t border-surface-100">
          6. Payment Disputes & Chargebacks
        </h2>
        <p>
          If you encounter any billing anomaly, unauthorized charge, or duplicate transaction, we urge you to contact our support team immediately at <a href={`mailto:${siteConfig.supportEmail}`} class="text-brand-700 underline font-medium">{siteConfig.supportEmail}</a> before filing a payment dispute or chargeback with your bank or credit card company. We resolve all verified duplicate or erroneous transactions promptly.
        </p>

        <!-- 7. Grievance & Billing Contact -->
        <h2 class="text-lg font-bold text-surface-900 pt-6 border-t border-surface-100">
          7. Billing & Grievance Contact
        </h2>
        <p>
          For any billing questions, refund claims, or tax invoice inquiries, contact:
        </p>
        <div class="p-4 bg-surface-50 border border-surface-200 rounded-2xl text-xs sm:text-sm space-y-1">
          <p><strong>Entity:</strong> {siteConfig.legalName}</p>
          <p><strong>Registered Address:</strong> {siteConfig.address}</p>
          <p><strong>Support & Billing Desk:</strong> <a href={`mailto:${siteConfig.supportEmail}`} class="text-brand-700 underline font-medium">{siteConfig.supportEmail}</a></p>
          <p><strong>Response SLA:</strong> Acknowledgment within 24 business hours</p>
        </div>
      </div>

    </div>
  </Section>
</Layout>
