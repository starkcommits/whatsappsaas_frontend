---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import { featuresList } from '../data/features';
import { siteConfig } from '../config/site';

const featuresJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${siteConfig.name} Platform Features`,
  description: 'Complete breakdown of WhatsApp Business features in ONO',
  itemListElement: featuresList.map((feature, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: feature.title,
    description: feature.shortDesc,
  })),
};

const aliasMap: Record<string, string[]> = {
  'shared-team-inbox': ['inbox', 'team-inbox'],
  'template-editor': ['templates', 'template-builder'],
  'whatsapp-flows': ['flows', 'in-chat-forms'],
  'consent-tracking': ['consent', 'opt-in', 'consent-and-stop'],
  'campaign-broadcasts': ['campaigns', 'broadcasts'],
};
---

<Layout
  title={`Features — ${siteConfig.name} WhatsApp Business Platform`}
  description="Explore the complete feature suite of ONO: shared inbox, template campaigns, consent tracking, WhatsApp Flows, team roles and developer APIs."
  jsonLd={featuresJsonLd}
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-[#E7F8EE] via-[#F2FAF5] to-white border-b border-emerald-100/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold uppercase tracking-wider text-brand-700 bg-brand-50 border border-brand-100 px-3.5 py-1 rounded-full mb-4">
        <span>Verified Capabilities</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-950 tracking-tight font-display leading-tight">
        Built on Meta's WhatsApp Business Platform (Cloud API)
      </h1>
      <p class="text-base sm:text-lg text-ink-500 mt-4 leading-relaxed">
        Everything you need to run collaborative team support, launch personalized broadcast campaigns, and stay compliant with WhatsApp platform rules.
      </p>

      <!-- Quick Jump Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-8 text-xs font-medium">
        {featuresList.map((feature) => (
          <a
            href={`#${feature.id}`}
            class="bg-white hover:bg-emerald-50 text-ink-700 hover:text-emerald-950 border border-emerald-200/60 px-3 py-1.5 rounded-lg transition-colors shadow-soft"
          >
            {feature.number}. {feature.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Detailed Feature Sections (One section per FEATURES item) -->
  <div class="divide-y divide-ink-100">
    {featuresList.map((feature, index) => {
      const aliases = aliasMap[feature.id] || [];

      return (
        <div class="relative">
          {aliases.map((alias) => (
            <div id={alias} class="scroll-mt-32 block h-px -mt-px pointer-events-none" aria-hidden="true" />
          ))}
          <Section id={feature.id} background={index % 2 === 0 ? 'white' : 'default'} class="scroll-mt-32">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Column 1: Feature Title & Number -->
          <div class="lg:col-span-5 space-y-3">
            <div class="flex items-center gap-3">
              <span class="text-3xl font-black font-mono text-brand-600">
                #{feature.number < 10 ? `0${feature.number}` : feature.number}
              </span>
              {feature.badge && (
                <span class="text-[10px] font-mono font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 border border-brand-100">
                  {feature.badge}
                </span>
              )}
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-ink-950 font-display tracking-tight leading-snug">
              {feature.title}
            </h2>
            <p class="text-base text-ink-500 leading-relaxed">
              {feature.shortDesc}
            </p>
          </div>

          <!-- Column 2: Deep Dive & Bullet Details -->
          <div class="lg:col-span-7 bg-white rounded-2xl border border-ink-100 p-6 sm:p-8 shadow-soft space-y-6">
            <div>
              <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-ink-500 mb-2">
                Operational Overview
              </h3>
              <p class="text-sm text-ink-700 leading-relaxed">
                {feature.detailedDesc}
              </p>
            </div>

            <div class="pt-4 border-t border-ink-100">
              <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-ink-500 mb-3">
                Key Technical Capabilities
              </h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-ink-700">
                {feature.keyPoints.map((point) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-brand-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span class="leading-relaxed">{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      </Section>
    </div>
  ); })}
</div>

  <!-- Bottom CTA -->
  <Section background="white">
    <CtaBand />
  </Section>

  <script is:inline>
    function handleAnchorScroll() {
      if (window.location.hash) {
        const hash = window.location.hash.substring(1);
        const el = document.getElementById(hash);
        if (el) {
          setTimeout(() => {
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 100);
        }
      }
    }
    window.addEventListener('load', handleAnchorScroll);
    window.addEventListener('hashchange', handleAnchorScroll);
  </script>
</Layout>
